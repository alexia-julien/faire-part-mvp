// Hébergement Cloudflare (Worker + fichiers statiques, déployé à chaque push sur `dev` par Workers Builds).
// Sert le site déjà publié à la racine du dépôt par `cd web && npm run deploy` : aucune étape de build nécessaire.
// _redirects (vraies 301) et _headers (X-Robots-Tag, cache) sont lus à la racine ; .assetsignore exclut les sources.
// worker/index.js ne tourne que pour la page des faire-part (aperçu WhatsApp personnalisé, voir le fichier).
{
  "name": "faire-part-mvp",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/invitation.html", "/invitation"]
  },
  // Clé « anon » publique par conception (déjà présente dans le site) : l'accès est verrouillé par les fonctions SQL.
  "vars": {
    "SUPABASE_URL": "https://pmtwhrqfdvbxbgrzcytl.supabase.co",
    "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBtdHdocnFmZHZieGJncnpjeXRsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTI1MjQ3MzEsImV4cCI6MjEwODEwMDczMX0.7jw9LLJC8dCBHe4fIPnLfgmIFVdbTC19oIR5ZytF-aw",
    "SITE_URL": "https://maison-meli.com",
    "CHECK_BACKUP": "1",
    "ALERT_TO": "contact@maison-meli.com"
  },
  // Sentinelle (worker/index.js, scheduled) : site + base + fraîcheur de la sauvegarde toutes les 5 min, alerte e-mail.
  // L'appel régulier à la base empêche la mise en pause automatique de l'offre gratuite Supabase.
  // Seul secret à définir dans le tableau de bord Cloudflare (jamais dans ce dépôt public) : RESEND_API_KEY.
  "triggers": { "crons": ["*/5 * * * *"] },
  "kv_namespaces": [{ "binding": "SENTINEL", "id": "b01e9770d8954ed196147349ded5ea52" }],
  // Recette (préproduction) : branche `staging` → Worker « maison-meli-staging » sur https://staging.maison-meli.com.
  // Workers Builds construit le site (cd web && npm ci && npm run build:staging) puis lance `npx wrangler deploy --env staging`.
  // Base Supabase de recette (projet pcppyluqhsbhkjzmjpzk) : aucune vraie donnée, aucune mesure comptée en production.
  // Seule /admin/ lit la production (voir web/lib/config.ts).
  "env": {
    "staging": {
      "name": "maison-meli-staging",
      "workers_dev": false,
      "routes": [{ "pattern": "staging.maison-meli.com", "custom_domain": true }],
      "assets": {
        "directory": "web/out",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        "html_handling": "auto-trailing-slash",
        "run_worker_first": ["/invitation.html", "/invitation"]
      },
      "vars": {
        "SUPABASE_URL": "https://pcppyluqhsbhkjzmjpzk.supabase.co",
        "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBjcHB5bHVxaHNiaGtqem1qcHprIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTU3MTQ4MzUsImV4cCI6MjExMTI5MDgzNX0.3Za1JrUuf45PYMl2gor2QvoiRzdTnIIbQ8OoGmCvEd8",
        "SITE_URL": "https://staging.maison-meli.com"
      },
      // Préprod : sentinelle toutes les heures, sans alerte e-mail (garde la base de recette éveillée).
      "triggers": { "crons": ["7 * * * *"] }
    }
  }
}
